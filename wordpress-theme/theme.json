{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "title": "LSX Design",
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "800px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "background",
          "color": "#FFFFFF",
          "name": "Background"
        },
        {
          "slug": "foreground",
          "color": "#090909",
          "name": "Foreground"
        },
        {
          "slug": "primary",
          "color": "#1E6AFF",
          "name": "Primary"
        },
        {
          "slug": "primary-foreground",
          "color": "#FFFFFF",
          "name": "Primary Foreground"
        },
        {
          "slug": "secondary",
          "color": "#7BE7FF",
          "name": "Secondary"
        },
        {
          "slug": "secondary-foreground",
          "color": "#0E3278",
          "name": "Secondary Foreground"
        },
        {
          "slug": "muted",
          "color": "#E1E1E1",
          "name": "Muted"
        },
        {
          "slug": "muted-foreground",
          "color": "#565656",
          "name": "Muted Foreground"
        },
        {
          "slug": "accent",
          "color": "#7BE7FF",
          "name": "Accent"
        },
        {
          "slug": "accent-foreground",
          "color": "#0E3278",
          "name": "Accent Foreground"
        },
        {
          "slug": "destructive",
          "color": "#CC0000",
          "name": "Destructive"
        },
        {
          "slug": "destructive-foreground",
          "color": "#FFFFFF",
          "name": "Destructive Foreground"
        },
        {
          "slug": "border",
          "color": "#757575",
          "name": "Border"
        },
        {
          "slug": "card",
          "color": "#FFFFFF",
          "name": "Card"
        },
        {
          "slug": "card-foreground",
          "color": "#090909",
          "name": "Card Foreground"
        }
      ],
      "gradients": [
        {
          "slug": "primary-gradient",
          "gradient": "linear-gradient(to right, #1E6AFF, #7BE7FF)",
          "name": "Primary Gradient"
        },
        {
          "slug": "background-gradient",
          "gradient": "radial-gradient(circle at 20% 80%, rgba(30, 106, 255, 0.15) 0%, rgba(30, 106, 255, 0) 50%)",
          "name": "Background Gradient"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "Lexend, sans-serif",
          "slug": "primary",
          "name": "Lexend (Primary)"
        },
        {
          "fontFamily": "Manrope, sans-serif",
          "slug": "secondary",
          "name": "Manrope (Secondary)"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "14px",
          "name": "Small",
          "fluid": false
        },
        {
          "slug": "base",
          "size": "16px",
          "name": "Base",
          "fluid": false
        },
        {
          "slug": "lg",
          "size": "18px",
          "name": "Large",
          "fluid": false
        },
        {
          "slug": "xl",
          "size": "20px",
          "name": "Extra Large",
          "fluid": false
        },
        {
          "slug": "2xl",
          "size": "24px",
          "name": "2X Large",
          "fluid": false
        },
        {
          "slug": "h6",
          "size": "16px",
          "name": "Heading 6",
          "fluid": false
        },
        {
          "slug": "h5",
          "size": "18px",
          "name": "Heading 5",
          "fluid": false
        },
        {
          "slug": "h4",
          "size": "20px",
          "name": "Heading 4",
          "fluid": false
        },
        {
          "slug": "h3",
          "size": "24px",
          "name": "Heading 3",
          "fluid": false
        },
        {
          "slug": "h2",
          "size": "32px",
          "name": "Heading 2",
          "fluid": false
        },
        {
          "slug": "h1",
          "size": "60px",
          "name": "Heading 1",
          "fluid": false
        }
      ],
      "fontWeight": true
    },
    "spacing": {
      "units": ["px", "em", "rem", "%", "vh", "vw"],
      "spacingSizes": [
        {
          "slug": "1",
          "size": "0.25rem",
          "name": "1"
        },
        {
          "slug": "2",
          "size": "0.5rem",
          "name": "2"
        },
        {
          "slug": "3",
          "size": "0.75rem",
          "name": "3"
        },
        {
          "slug": "4",
          "size": "1rem",
          "name": "4"
        },
        {
          "slug": "5",
          "size": "1.25rem",
          "name": "5"
        },
        {
          "slug": "6",
          "size": "1.5rem",
          "name": "6"
        },
        {
          "slug": "8",
          "size": "2rem",
          "name": "8"
        },
        {
          "slug": "10",
          "size": "2.5rem",
          "name": "10"
        },
        {
          "slug": "12",
          "size": "3rem",
          "name": "12"
        },
        {
          "slug": "16",
          "size": "4rem",
          "name": "16"
        },
        {
          "slug": "20",
          "size": "5rem",
          "name": "20"
        },
        {
          "slug": "24",
          "size": "6rem",
          "name": "24"
        },
        {
          "slug": "32",
          "size": "8rem",
          "name": "32"
        },
        {
          "slug": "40",
          "size": "10rem",
          "name": "40"
        },
        {
          "slug": "48",
          "size": "12rem",
          "name": "48"
        }
      ],
      "padding": true,
      "margin": true,
      "blockGap": true
    },
    "border": {
      "radius": true,
      "color": true,
      "style": true,
      "width": true
    },
    "custom": {
      "borderRadius": {
        "sm": "2px",
        "default": "4px",
        "md": "6px",
        "lg": "8px",
        "xl": "12px",
        "2xl": "16px",
        "full": "9999px"
      },
      "shadow": {
        "sm": "0 1px 3px rgba(0, 0, 0, 0.05)",
        "md": "0 4px 6px rgba(0, 0, 0, 0.05)",
        "lg": "0 10px 40px rgba(0, 0, 0, 0.15)",
        "xl": "0 20px 40px rgba(0, 0, 0, 0.12)",
        "primary": "0 4px 12px rgba(30, 106, 255, 0.3)"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--primary)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.6",
      "fontWeight": "400"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0",
        "right": "1.5rem",
        "bottom": "0",
        "left": "1.5rem"
      }
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)",
          "fontSize": "var(--wp--preset--font-size--h1)",
          "fontWeight": "500",
          "lineHeight": "1.1"
        },
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "1.5rem"
          }
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)",
          "fontSize": "var(--wp--preset--font-size--h2)",
          "fontWeight": "500",
          "lineHeight": "1.2"
        },
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "1.5rem"
          }
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)",
          "fontSize": "var(--wp--preset--font-size--h3)",
          "fontWeight": "500",
          "lineHeight": "1.3"
        },
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "1rem"
          }
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)",
          "fontSize": "var(--wp--preset--font-size--h4)",
          "fontWeight": "500",
          "lineHeight": "1.4"
        },
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "1rem"
          }
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)",
          "fontSize": "var(--wp--preset--font-size--h5)",
          "fontWeight": "500",
          "lineHeight": "1.4"
        },
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "0.75rem"
          }
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)",
          "fontSize": "var(--wp--preset--font-size--h6)",
          "fontWeight": "500",
          "lineHeight": "1.4"
        },
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "0.75rem"
          }
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "typography": {
            "textDecoration": "underline"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--primary-foreground)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)",
          "fontSize": "var(--wp--preset--font-size--base)",
          "fontWeight": "500"
        },
        "spacing": {
          "padding": {
            "top": "12px",
            "right": "24px",
            "bottom": "12px",
            "left": "24px"
          }
        },
        "border": {
          "radius": "4px"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary)",
            "text": "var(--wp--preset--color--primary-foreground)"
          }
        }
      }
    },
    "blocks": {
      "core/paragraph": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--secondary)",
          "fontSize": "var(--wp--preset--font-size--base)"
        }
      },
      "core/heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)",
          "fontWeight": "500"
        }
      },
      "core/button": {
        "border": {
          "radius": "4px"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)"
        }
      },
      "core/buttons": {
        "spacing": {
          "blockGap": "1rem"
        }
      },
      "core/group": {
        "spacing": {
          "padding": "0",
          "blockGap": "1.5rem"
        }
      },
      "core/columns": {
        "spacing": {
          "blockGap": "3rem"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "blank",
      "title": "Blank",
      "postTypes": ["page", "post"]
    }
  ]
}
